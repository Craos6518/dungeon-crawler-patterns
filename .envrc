# Configuración automática de JAVA_HOME con direnv
# 
# Para usar direnv:
# 1. Instalar direnv: https://direnv.net/docs/installation.html
# 2. Agregar a tu shell (~/.bashrc, ~/.zshrc): eval "$(direnv hook bash)" o eval "$(direnv hook zsh)"
# 3. Ejecutar en este directorio: direnv allow
# 
# Después, cada vez que entres a este directorio, JAVA_HOME se configurará automáticamente

# Detectar Java 17
if [ -d "/usr/lib/jvm/java-17-temurin-jdk" ]; then
    export JAVA_HOME="/usr/lib/jvm/java-17-temurin-jdk"
elif [ -d "/usr/lib/jvm/java-17-openjdk" ]; then
    export JAVA_HOME="/usr/lib/jvm/java-17-openjdk"
else
    # Fallback: buscar cualquier Java 17
    export JAVA_HOME=$(find /usr/lib/jvm -name "java-17*" -type d 2>/dev/null | head -1)
fi

# Agregar Java al PATH
export PATH="$JAVA_HOME/bin:$PATH"

# Mensaje de bienvenida (opcional)
echo "✓ JAVA_HOME configurada: $JAVA_HOME"
