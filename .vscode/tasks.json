{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: Compilar",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean",
                "compile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$maven-executable-compile",
            "options": {
                "env": {
                    "JAVA_HOME": "/usr/lib/jvm/java-17-temurin-jdk"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Maven: Ejecutar Tests",
            "type": "shell",
            "command": "mvn",
            "args": [
                "test"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$maven-executable-compile",
            "options": {
                "env": {
                    "JAVA_HOME": "/usr/lib/jvm/java-17-temurin-jdk"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Maven: Limpiar",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean"
            ],
            "problemMatcher": [],
            "options": {
                "env": {
                    "JAVA_HOME": "/usr/lib/jvm/java-17-temurin-jdk"
                }
            }
        },
        {
            "label": "Maven: Package",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean",
                "package"
            ],
            "problemMatcher": "$maven-executable-compile",
            "options": {
                "env": {
                    "JAVA_HOME": "/usr/lib/jvm/java-17-temurin-jdk"
                }
            }
        },
        {
            "label": "Ejecutar Main",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "target/classes",
                "game.Main"
            ],
            "dependsOn": "Maven: Compilar",
            "problemMatcher": [],
            "options": {
                "env": {
                    "JAVA_HOME": "/usr/lib/jvm/java-17-temurin-jdk"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Ejecutar Demo Patrones Estructurales",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "target/classes",
                "game.demo.PatronesEstructuralesDemo"
            ],
            "dependsOn": "Maven: Compilar",
            "problemMatcher": [],
            "options": {
                "env": {
                    "JAVA_HOME": "/usr/lib/jvm/java-17-temurin-jdk"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
